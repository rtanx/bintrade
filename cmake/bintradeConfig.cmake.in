@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Anything that appears in bintrade::bintrade's INTERFACE_LINK_LIBRARIES
# must be importable by downstream consumers.  For a STATIC library this
# includes both PUBLIC and PRIVATE link dependencies (CMake retains the
# private ones under $<LINK_ONLY:...> so the final linker has the
# symbols), so all of them need a find_dependency() here.
find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)
find_dependency(fmt CONFIG REQUIRED)
find_dependency(Boost CONFIG REQUIRED COMPONENTS system asio)
find_dependency(OpenSSL REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/bintradeTargets.cmake")

check_required_components(bintrade)
